rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'Administrador';
    }

    match /pedidos/{folio} {
      allow create: if true;
      allow get: if true;
      allow list: if isStaff();
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /listas/{grado} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // catálogo de uniformes (nombre, precio, tallas, foto): lo edita el Administrador
    match /uniformes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /inventario/{itemId} {
      allow read: if true;
      allow update: if isStaff() || (request.resource.data.stock <= resource.data.stock);
      allow create, delete: if isStaff();
    }

    match /usuarios/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow read, write: if isAdmin();
    }

    // Puntero de b\u00fasqueda "olvid\u00e9 mi folio": la clave del documento ya es
    // el nombre completo + tel\u00e9fono combinados, as\u00ed que solo se puede leer
    // si ya sabes exactamente esos dos datos (nunca se puede listar todo).
    // "Avísame cuando haya" (uniformes agotados): cualquier papá puede registrarse,
    // pero solo el personal puede ver la lista (tiene teléfonos y correos).
    match /avisos/{id} {
      allow create: if request.resource.data.keys().hasOnly(['uniformeId','nombre','talla','telefono','correo','estado','createdAt'])
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.telefono is string && request.resource.data.telefono.size() <= 15
                    && request.resource.data.correo is string && request.resource.data.correo.size() <= 120
                    && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 80
                    && request.resource.data.talla is string && request.resource.data.talla.size() <= 10;
      allow read, update: if isStaff();
      allow delete: if isAdmin();
    }

    // Comprobantes de transferencia ya usados (por clave de rastreo y huellas de la imagen):
    // se crean al hacer el pedido y nunca se pueden reescribir, así un comprobante no sirve para dos pedidos.
    match /comprobantes/{id} {
      allow get: if true;
      allow create: if request.resource.data.keys().hasOnly(['folio','at']) && request.resource.data.folio is string;
      allow list: if isStaff();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Nivel de inglés de 1° de secundaria: se consulta por nombre exacto (la clave es el nombre normalizado);
    // nunca se puede listar completo desde la tienda. Solo el Administrador lo carga.
    match /nivelesIngles/{clave} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    match /busquedas/{key} {
      allow get: if true;
      allow create, update: if true;
      allow list: if false;
      allow delete: if isAdmin();
    }
  }
}
